# --- Obligatoire ---
DOMAIN=votre-domaine.fr                  # utilisé par Caddy pour le certificat HTTPS
BASE_URL=https://votre-domaine.fr        # sans barre oblique finale
CONTACT_EMAIL=contact@votre-domaine.fr

# --- Mentions légales (affichées sur /mentions-legales) ---
LEGAL_NAME=Prénom Nom
LEGAL_STATUS=Entrepreneur individuel (micro-entreprise)
LEGAL_ADDRESS=1 rue Exemple, 75000 Paris
LEGAL_SIRET=000 000 000 00000
LEGAL_DIRECTOR=Prénom Nom
LEGAL_HOST=Nom de l'hébergeur, adresse, téléphone

# --- Paiement Stripe (les abonnements restent désactivés tant que c'est vide) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=

# --- E-mails (bienvenue, mot de passe oublié, alertes, nouveaux prospects) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Auditeo <contact@votre-domaine.fr>

# --- Facultatif ---
BRAND_NAME=Auditeo
SCAN_CONCURRENCY=2
ANON_DAILY_SCANS=3
